# LR Popcorn Club - Environment Configuration Example
# Copy this to your Vercel Project Environment Variables (Settings -> Environment Variables)

# Node Environment
NODE_ENV=production

# Server Session & Token Secret (Generate a 64-char random hex string)
# e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_secure_random_64_character_hex_string

# Initial Primary Owner Credentials (Used only for first-time automated bootstrap if no accounts exist)
PRIMARY_OWNER_NAME="Mom"
PRIMARY_OWNER_USERNAME="owner"
PRIMARY_OWNER_INITIAL_PASSWORD=replace_with_initial_strong_password

# Supabase PostgreSQL Configuration (Optional - Recommended for Multi-Device Cloud Production)
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

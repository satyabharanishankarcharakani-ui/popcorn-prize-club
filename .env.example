# LR Popcorn Prize Club — Environment Variables Template
# Configure these in Vercel Project Settings -> Environment Variables. Never commit real values.

NODE_ENV=production

# Cryptographic secret (minimum 32 characters) for signing HttpOnly session tokens
AUTH_SECRET=replace_with_64_char_random_hex_secret

# Initial Owner Bootstrap (used only once when the users table is empty)
PRIMARY_OWNER_NAME=Mom
PRIMARY_OWNER_USERNAME=owner
PRIMARY_OWNER_EMAIL=owner@popcornclub.local
PRIMARY_OWNER_INITIAL_PASSWORD=replace_with_strong_initial_password

# Managed PostgreSQL Database (Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Optional Distributed Rate Limiting (Upstash Redis / Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
